        {
            printf("The middle number is %d\n", num2);
        }
        else
        {
            printf("The middle number is %d\n", num3);
        }
    }
    else
    {
        if(num2 > num1)
        {
            if(num2 < num3)
            {
                printf("The middle number is %d\n", num2);
            }
            else if(num1 > num3)
            {
                printf("The middle number is %d\n", num1);
            }
            else
            {
                printf("The middle number is %d\n", num3);
            }
        }
    }
}

