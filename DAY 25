//sum and average using pointer and functions
#include <stdio.h>
void sum_avg(int n1, int n2, int *sum, float *avg)
{
    *sum = n1 + n2;
    *avg = *sum /2.0;
}
int main() {
    int n1, n2, sum; 
    float avg;
    scanf("%d %d", &n1, &n2);
    sum_avg(n1, n2, &sum, &avg);
    printf("sum: %d\navg: %f\n", sum, avg);
    return 0;
}
