3) strcat - string concatenate
- used to print both dest and src strings into src
- prototype
char * strcat(char *restrict dst, const char *restrict src)
eg:
1) 
#include <stdio.h>
char my_strcat(char *str1, char *str2)
{
    int i = 0, j=0;
    while(str1[i] != '\0')
    {
        i++;
    }
    while(str2[j] != '\0')
    {
        str1[i] = str2[j];
        i++;
        j++;
    }
    str1[i] = '\0';
}
int main(){
    char str1[50];
    scanf("%s", str1);
    char str2[50];
    scanf("%s", str2);
    my_strcat(str1, str2);
    printf("concatenate string is %s", str1);
    return 0;
}

4)strcmp - string compare
- prototype
int strcmp (char *s1, char *s2)
- used to check if both strings are equal or not
- if equal - return 0
- if s1>s2 - return +ve
- if s1 < s2 - return -ve
- here postive and negative values are the differences of their ASCII values.
eg:
1)
#include <stdio.h>
int my_strcmp(char *str1, char *str2)
{
    int i = 0;
    while(str1[i] != '\0' || str2[i] != '\0')
    {
        if(str1[i] != str2[i])
        {
            return 1;
        }
        i++;
    }
    return 0;
}
int main(){
    char str1[50];
    char str2[50];
    printf("Enter the string1 : ");
    fgets(str1, 50, stdin);
    printf("Enter the string2 : ");
    fgets(str2, 50, stdin);
    int res = my_strcmp(str1, str2);
    if(res==0)
    printf("Entered Strings are equal\n");
    else
    printf("Entered Strings are not equal\n");
    return 0;
}
