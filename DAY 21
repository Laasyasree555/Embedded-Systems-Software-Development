//median of two unsorted arrays
#include <stdio.h>
int main() {
    int size1, size2, i, j, temp = 0;
    float median1, median2;
    printf("Enter size of array 1: ");
    scanf("%d", &size1);
    printf("Enter size of array 2: ");
    scanf("%d", &size2);
    int arr1[size1];
    printf("Enter array 1 elements: ");
    for(i = 0; i<size1; i++)
    {
        scanf("%d", &arr1[i]);
    }
    int arr2[size2];
    printf("Enter array 2 elements: ");
    for(i = 0; i<size2; i++)
    {
        scanf("%d", &arr2[i]);
    }
    for(i = 0; i<size1; i++)
    {
        for(j = i+1; j < size1; j++)
        {
            if(arr1[i] > arr1[j])
            {
            temp = arr1[i];
            arr1[i] = arr1[j];
            arr1[j] = temp;
            }
        }
}
for(i = 0; i< size1; i++)
{
    printf("%d ", arr1[i]);
}
printf("\n");
for(i = 0; i<size2; i++)
    {
        for(j = i+1; j < size2; j++)
        {
            if(arr2[i] > arr2[j])
            {
            temp = arr2[i];
            arr2[i] = arr2[j];
            arr2[j] = temp;
        }
    }
}
for(i = 0; i< size2; i++)
{
    printf("%d ", arr2[i]);
}
printf("\n");
if(size1 % 2 == 1)
{
    median1 = (float)arr1[size1/2];
    printf("Median of array 1: %g\n", median1);
}
else
{
    median1 = (arr1[size1/2] + arr1[size1 /2 - 1])/2.0;
    printf("Median of array 1: %g\n", median1);
}

if(size2 % 2 == 1)
{
    median2 = (float)arr2[size2 /2];
    printf("Median of array 2: %g\n", median2);
}
else
{
    median2 = (arr2[size2 /2] + arr2[size2 /2 - 1])/2.0;
    printf("Median of array 2: %g\n", median2);
}

printf("Median of both arrays: %g\n", (median1+median2)/2.0);
return 0;
}
