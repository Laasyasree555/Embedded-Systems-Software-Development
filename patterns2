#include <stdio.h>
int main() {
    int i, j, space, n=4;
    for(i = 1; i<=4; i++)
    {
        for(space = 1; space<=(n-i); space++)
        {
            printf("-");
        }
        for(j = 1; j <=i; j++)
        {
            printf("%d", j);

        }
        printf("\n");
    }
    return 0;
}
