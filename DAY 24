3) Rotate elements k times in clock-wise

#include <stdio.h>
int main() {
    int size, i, backup = 0, k, j;
    printf("Enter the size: ");
    scanf("%d", &size);
    int arr[size];
    printf("Enter array elements: ");
    for(i = 0; i<size; i++)
    {
        scanf("%d", &arr[i]);
    }
    printf("Enter how many times you wanted to run the loop: ");
    scanf("%d", &k);
    while(k > 0)
    {
    backup = arr[size - 1];
    for(i = size - 1 ; i >  0; i--)
    {
        arr[i] = arr[i - 1];
    }
    arr[i] = backup;
    k--;
}
    for(i = 0; i<size; i++)
    {
        printf("%d ", arr[i]);
    }
    return 0;
}

4) Remove duplicate elements in an array and print the output

#include <stdio.h>
int main() {
    int size, i, j, k;
    scanf("%d", &size);
    int arr[size];
    for(i = 0; i< size; i++)
    {
        scanf("%d", &arr[i]);
    }
    for(i = 0; i< size; i++)
    {
        for(j = i+1; j< size ; j++)
        {
            if(arr[i] == arr[j])
            {
                for(k = j; k < size - 1; k++)
                {
                    arr[k] = arr[k+1];
                }
                size--;
                j--;
            }
        }
    }
    for(i = 0; i< size; i++)
    {
    printf("%d, ", arr[i]);
    }
    return 0;
}

