    for(i = 0; i< size; i++)
    {
        scanf("%d", &arr[i]);
    }
    int largest = arr[0];
    int smallest = arr[0];
    for(i = 1; i<size; i++)
    {
        if(arr[i] > largest)
        {
            largest = arr[i];
        }
        else if(arr[i] < smallest)
        {
            smallest = arr[i];
        }
    }
    int second_largest = smallest;
    for(i = 0; i< size; i++)
    {
        if(arr[i] > second_largest  && arr[i] < largest)
        {
