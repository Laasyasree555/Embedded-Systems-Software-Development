#include <stdio.h>
int main() {
    int num, rem, last_digit;
    printf("Enter num: ");
    scanf(" %d", &num);
    while(num != 0)
    {
        rem = num%10;
        last_digit = rem;
    }
    printf("last_digit: %d", last_digit);
    return 0;
}
