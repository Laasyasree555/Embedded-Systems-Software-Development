PROGRAM:
#include <stdio.h>

int is_xdigit(int);

int main()
{
    char ch;
    short ret;
    
    printf("Enter a character: ");
    scanf("%c", &ch);
    
    ret = is_xdigit(ch);
    
    /* Based on the return value of the function print the message */
    if(ret == 1)
    printf("Entered character is an hexadecimal digit\n");
    else
    printf("Entered character is not an hexadecimal digit\n");
    
    return 0;
}
int is_xdigit(int ch)
{
    if(ch >= '0' && ch<= '9')
    {
        return 1;
    }
    else if(ch >= 'A' && ch<= 'F')
    {
        return 1;
    }
    else if(ch >= 'a' && ch<= 'f')
    {
        return 1;
    }
    else
    return 0;
}
